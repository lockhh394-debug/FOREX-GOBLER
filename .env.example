# Local/full-stack runtime configuration. Never commit real values.
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/forex_gobler

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_CLERK_PROXY_URL=

# Set this to the Clerk user ID allowed to review payments.
ADMIN_USER_IDS=user_replace_me

# Replit Object Storage paths, supplied after creating the buckets.
PUBLIC_OBJECT_SEARCH_PATHS=/bucket/public
PRIVATE_OBJECT_DIR=/bucket/private

# Use a verified domain address for RESEND_FROM_EMAIL in production.
RESEND_FROM_EMAIL=Forex Gobler <onboarding@resend.dev>
REPLY_TO_EMAIL=supportxauusdgobler@gmail.com

# Optional logging/runtime values.
NODE_ENV=development
LOG_LEVEL=info
